<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- Keeps [MustDisposeResource] in the compiled DLL, not just the source. -->
    <DefineConstants>$(DefineConstants);JETBRAINS_ANNOTATIONS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.2.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Which rules find a leak? dotnet build -p:DisposeProbe=true -p:AnalysisMode=All -->
    <Compile Remove="DisposeProbe.cs" Condition="'$(DisposeProbe)' != 'true'" />
    <!-- What ReSharper reports: see the header of LeakProbe/LeakProbe.cs. -->
    <Compile Remove="LeakProbe\**" />
  </ItemGroup>
</Project>
