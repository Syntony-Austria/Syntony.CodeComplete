<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.2.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="SpanCounter\**" />
    <!-- A const is copied into the caller: bash ConstProbe/run.sh -> 3 3, 3 7. -->
    <Compile Remove="ConstProbe\**" />
    <!-- Proof the rules bite: dotnet build -p:VariableProbe=true reports them;
         add -p:EnforceCodeStyleInBuild=true for the IDE rules in .editorconfig. -->
    <Compile Remove="VariableProbe.cs" Condition="'$(VariableProbe)' != 'true'" />
  </ItemGroup>
</Project>
