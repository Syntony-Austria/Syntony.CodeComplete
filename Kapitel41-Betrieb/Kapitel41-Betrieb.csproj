<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json"
                      Version="10.0.0" />
    <PackageReference
        Include="Microsoft.Extensions.Configuration.EnvironmentVariables"
        Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing"
                      Version="10.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers"
                      Version="3.3.4" PrivateAssets="all" />
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.2.0" />
  </ItemGroup>
  <!-- The stage names of chapter 40, read the same way here. -->
  <ItemGroup>
    <Compile Include="..\Kapitel40-Ausliefern\Stage.cs" Link="Stage.cs" />
  </ItemGroup>
  <!-- The finding became a rule. -p:NarrowBan=true uses the first draft,
       -p:NoParamsBan=true one entry without a parameter list. -->
  <ItemGroup Condition="'$(NarrowBan)' != 'true' AND '$(NoParamsBan)' != 'true'">
    <AdditionalFiles Include="BannedSymbols.txt" />
    <AdditionalFiles Include="BannedSymbols.Lists.txt" />
  </ItemGroup>
  <ItemGroup Condition="'$(NarrowBan)' == 'true'">
    <AdditionalFiles Include="BannedSymbols.Narrow.txt" />
  </ItemGroup>
  <ItemGroup Condition="'$(NoParamsBan)' == 'true'">
    <AdditionalFiles Include="BannedSymbols.NoParams.txt" />
  </ItemGroup>
  <!-- Measurement projects with their own nuget.config: python messen.py -->
  <ItemGroup>
    <Compile Remove="Lieferkette\**" />
    <None Remove="Lieferkette\**" />
  </ItemGroup>
  <!-- Deliberately red probes: dotnet test -p:Probe=true -->
  <ItemGroup Condition="'$(Probe)' != 'true'">
    <Compile Remove="Probe\**" />
  </ItemGroup>
  <!-- Must not compile: dotnet build -p:ProbeBann=true (RS0030) -->
  <ItemGroup Condition="'$(ProbeBann)' != 'true'">
    <Compile Remove="ProbeBann\**" />
  </ItemGroup>
</Project>
