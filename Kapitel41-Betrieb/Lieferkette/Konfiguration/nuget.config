<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="intern" value="%FEEDS%/intern" />
    <add key="fremd" value="%FEEDS%/fremd" />
  </packageSources>
  <packageSourceMapping>
    <!-- Our own names come only from our own feed. If it is empty,
         restore fails (NU1101) instead of taking the look-alike. -->
    <packageSource key="intern">
      <package pattern="Library.*" />
    </packageSource>
    <packageSource key="fremd">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <!-- accept lets unsigned packages in; require stops them (NU3004). -->
    <add key="signatureValidationMode" value="accept" />
  </config>
</configuration>
