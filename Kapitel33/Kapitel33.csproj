<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.2.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Library.Fees\**" />
    <ProjectReference Include="Library.Fees/Library.Fees.csproj" />
  </ItemGroup>
  <!-- Deliberately red probe: dotnet test -p:RetryProbe=true -->
  <ItemGroup Condition="'$(RetryProbe)' != 'true'">
    <Compile Remove="Probe\**" />
  </ItemGroup>
</Project>
