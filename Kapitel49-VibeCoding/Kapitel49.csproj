<Project Sdk="Microsoft.NET.Sdk">
  <!-- Template for Measure-Proben.py and Measure-Analyzer.py: they copy it
       next to ProbeTests.cs and one solution from Proben. It does not
       build on its own (Auszug-knapp-1.cs is a printed excerpt). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.2.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Proben\**" />
  </ItemGroup>
</Project>
