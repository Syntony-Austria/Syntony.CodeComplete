<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rules\Rules.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <!-- Proof the rule bites: dotnet build -p:RuleProbe=true must fail. -->
    <Compile Remove="RuleProbe.cs" Condition="'$(RuleProbe)' != 'true'" />
    <Compile Remove="QualityProbe.cs" Condition="'$(QualityProbe)' != 'true'" />
  </ItemGroup>
</Project>
