<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <RootNamespace>Library.Lending</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.2.0" />
  </ItemGroup>
  <!-- The child process for the invariant mode has its own project. -->
  <ItemGroup>
    <Compile Remove="Invariant\**" />
    <None Remove="Invariant\**" />
  </ItemGroup>
  <!-- Deliberately red probes: dotnet test -p:Probe=true -->
  <ItemGroup Condition="'$(Probe)' != 'true'">
    <Compile Remove="Probe\**" />
  </ItemGroup>
  <!-- The broken resx pair is read as a file, never embedded. -->
  <ItemGroup>
    <EmbeddedResource Remove="Probe\**" />
  </ItemGroup>
</Project>
